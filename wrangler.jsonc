{
  "name": "rakuten-auto-affiliate",
  "main": "./worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rakuten-affiliate-db",
      "database_id": "81926891-4dd8-4cc2-b966-e530d2912452"
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "0 21 * * *"
    ]
  },
  "vars": {
    "RAKUTEN_SITE_ORIGIN": "https://rakuten-auto-affiliate.116kousei0428.workers.dev"
  }
}
